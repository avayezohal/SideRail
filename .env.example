PORT=8080
NODE_ENV=production

# Persistent data directory (mount a Railway volume here)
SIDERAIL_DATA_DIR=/data

# Secret used to sign admin session cookies. CHANGE THIS.
JWT_SECRET=change-me-to-a-long-random-string

# Core engine release to download on first boot
CORE_VERSION=v26.9.9

# Internal core API + inbound base port (usually no need to change)
CORE_API_PORT=10085
CORE_INBOUND_BASE_PORT=20000

# Public domain used to build client links. Railway sets RAILWAY_PUBLIC_DOMAIN
# automatically; override only if you use a custom domain.
PUBLIC_DOMAIN=
